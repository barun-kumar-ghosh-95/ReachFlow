# Database Configuration
POSTGRES_USER=visionattend
POSTGRES_PASSWORD=visionattend123
POSTGRES_DB=visionattend_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Security Configuration
SECRET_KEY=your-super-secret-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Configuration
APP_NAME=VisionAttend AI
APP_ENV=development
DEBUG=true

# Face Recognition Thresholds
FACE_RECOGNITION_THRESHOLD=0.65
LIVENESS_THRESHOLD=0.70
FACE_QUALITY_THRESHOLD=0.50
MIN_BOX_SIZE=60

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Upload Configuration
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
