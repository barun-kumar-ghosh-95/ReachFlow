# Environment Variables for ReachFlow
# Copy this file to .env.local and fill in the values

# ============================================================
# Application
# ============================================================
APP_URL=http://localhost:3000
NODE_ENV=development
DEMO_MODE=true

# ============================================================
# Database
# ============================================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/reachflow"

# ============================================================
# Redis
# ============================================================
REDIS_URL="redis://localhost:6379"

# ============================================================
# Authentication (NextAuth)
# ============================================================
AUTH_SECRET="your-auth-secret-min-32-chars-change-this"
AUTH_URL=http://localhost:3000

# ============================================================
# WhatsApp (Meta WhatsApp Business Cloud API)
# ============================================================
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ============================================================
# Email Provider (Resend)
# ============================================================
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_NAME="ReachFlow"
EMAIL_FROM_ADDRESS=noreply@reachflow.app

# SMTP fallback (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ============================================================
# Stripe Billing
# ============================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================================
# AI (OpenAI)
# ============================================================
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ============================================================
# Object Storage (S3-compatible)
# ============================================================
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=reachflow
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_URL=http://localhost:9000/reachflow

# ============================================================
# Transactional Email (for system emails)
# ============================================================
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_API_KEY=

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
