{
  "name": "reachflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:start": "node scripts/start-db.js",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "worker": "tsx workers/index.ts",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.4.2",
    "@prisma/client": "^5.19.0",
    "@radix-ui/react-dialog": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.1",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.12.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.439.0",
    "next": "14.2.13",
    "next-auth": "^5.0.0-beta.20",
    "nodemailer": "^6.9.14",
    "openai": "^4.58.1",
    "papaparse": "^5.4.1",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
