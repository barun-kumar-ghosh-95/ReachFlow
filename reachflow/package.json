    "@types/uuid": "^10.0.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^8",
    "eslint-config-next": "14.2.13",
    "jest": "^29.7.0",
    "prisma": "^5.19.0",
    "tsx": "^4.19.1",
    "typescript": "^5"
